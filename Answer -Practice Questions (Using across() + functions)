library(tibble)
library(dplyr)
set.seed(123)

flights <- tibble(
  flight_id   = 1:50,
  carrier     = sample(c("AA","DL","UA","SW"), 50, replace = TRUE),
  origin      = sample(c("JFK","LAX","ORD","ATL"), 50, replace = TRUE),
  dest        = sample(c("MIA","SEA","DFW","DEN"), 50, replace = TRUE),
  dep_delay   = rnorm(50, mean = 10, sd = 5),   # departure delay in minutes
  arr_delay   = rnorm(50, mean = 8, sd = 7),    # arrival delay in minutes
  air_time    = rnorm(50, mean = 120, sd = 30), # flight duration
  distance    = rnorm(50, mean = 800, sd = 200),# miles
  seats       = sample(100:200, 50, replace = TRUE),
  passengers  = sample(80:180, 50, replace = TRUE)
)

flights |> glimpse()

