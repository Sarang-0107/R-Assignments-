# Question 2:	Round all numeric columns to 2 decimal places. 
sales_data_round <- sales_data |> 
    mutate(across(where(is.numeric), \(x) round(x, 2)))
sales_data_round |> glimpse()

# Question 3:Replace all NA values in numeric columns with 0. 
sales_data[sapply(sales_data, is.numeric)] <- 
  lapply(sales_data[sapply(sales_data, is.numeric)], function(x){
    replace(x, is.na(x),0)
  })
sales_data |> glimpse()

sales_data_replace <- sales_data |> 
  mutate(across(where(is.numeric),\(x) replace(x, is.na(x), 0))) |>
  glimpse()
sales_data_replace
view(sales_data_replace)

# Question 4:	Apply log() transformation to all numeric columns. 

sales_data[sapply(sales_data,is.numeric)] <-
  lapply(sales_data[sapply(sales_data,is.numeric)], function(x){
    lag(x)
  })
sales_data |> glimpse()

sales_data_lag <- sales_data |> 
  mutate(across(where(is.numeric), \(x) lag(x))) 
