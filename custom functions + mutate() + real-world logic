#***********Scenario 1: Temperature Cleaning & Labeling

#You have a dataset weather with a column temp_c.

#Tasks:
  
 # Replace missing temperatures with the average temperature.
#Create a category:
 # "cold" if < 10
#"moderate" if 10–25
#"hot" if > 25
#Keep only the used columns.
***************************************************************************************
view(weather)

weather_temp <- function(data, temp) {
  data %>% 
    mutate(
      {{temp}} := ifelse(
        is.na({{temp}}),
        mean({{temp}},na.rm =TRUE), {{temp}}),
      temp_category = case_when(
        {{temp}} < 10  ~ "cold",
        {{temp}} >= 10 & {{temp}} <= 25 ~ "Moderate",
        {{temp}} > 25 ~ "hot"
      ),.keep = "used"
    ) %>% 
    select({{temp}}, temp_category)
}
  
  weather <- weather_temp(weather, temp)
weather  

