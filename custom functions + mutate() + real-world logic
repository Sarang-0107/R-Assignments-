#*******************************************************************************
#*🧠 Scenario 5: Gym Workout Duration

#Dataset: workouts with duration (minutes).

#Tasks:
  
 # Replace NA with 30.
#Categorize:
 # "short" < 20
#"medium" 20–45
#"long" > 45

#*******************************************************************************

set.seed(101)

workouts <- tibble(
  workout_id = 1:85,
  user = paste0("U", 1:85),
  workout_type = sample(c("Cardio", "Strength", "Yoga", "HIIT"), 85, replace = TRUE),
  duration = sample(c(NA, 10:90), 85, replace = TRUE),
  calories_burned = sample(50:800, 85, replace = TRUE),
  heart_rate = sample(60:180, 85, replace = TRUE),
  intensity = sample(c("Low", "Medium", "High"), 85, replace = TRUE),
  day = sample(1:7, 85, replace = TRUE),
  trainer = sample(c("A", "B", "C"), 85, replace = TRUE),
  location = sample(c("Gym", "Home", "Park"), 85, replace = TRUE)
)
view(workouts)

to_thirty <- function(x) {
  ifelse(is.na(x), 30, x)
}

durations <- function(x) {
  case_when(
    x < 20 ~ "short",
    x <= 45 ~ "medium",
    TRUE ~ "long"
  )
}

Gym_dura <- workouts %>% 
  mutate(
    duration = to_thirty(duration),
    workout_speed = durations(duration))
Gym_dura
