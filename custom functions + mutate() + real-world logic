#***************************************************************
library(tidyverse)

set.seed(123)

employees <- tibble(
  id = 1:85,
  name = paste0("Emp", 1:85),
  department = sample(c("HR", "IT", "Finance", "Sales"), 85, replace = TRUE),
  salary = sample(2000:10000, 85, replace = TRUE),
  age = sample(21:60, 85, replace = TRUE),
  experience = sample(0:35, 85, replace = TRUE),
  city = sample(c("Singapore", "KL", "Bangkok", "Jakarta"), 85, replace = TRUE),
  performance_score = sample(1:100, 85, replace = TRUE),
  bonus_eligible = sample(c("Yes", "No"), 85, replace = TRUE),
  hire_year = sample(2000:2024, 85, replace = TRUE)
)
employees

Salary_increment <- function(x) {
  ifelse(
  x < 3000 , 
  x*1.20,
  x * 1.10
  )
}
salary_category <- function(x) {
  case_when(
    x < 3000 ~ "Low",
    x >= 3000 & x <=7000 ~ "mid",
    x > 7000 ~ "high"
  )
}

Salary_adjustment <- employees %>% 
  mutate(New_Salary =Salary_increment(salary),
         category = salary_category(salary)
  )
Salary_adjustment

employees %>% 
  mutate(
    new_salary =ifelse(salary < 3000, salary *1.20, salary*1.10),
    
    category= case_when(
      salary < 3000 ~ "low",
      salary <= 7000 ~ "mid",
      TRUE ~ "High"
    )
    ,.keep = "used"
  )

