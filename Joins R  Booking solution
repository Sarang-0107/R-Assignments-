#🔵 Gap Analysis
#Find bookings that do not fit into any availability window
notfit <- bookings %>% 
  anti_join(
    rooms,
    by = join_by(room_id,
                 x$start_date >= y$start_date,
                 x$end_date <= y$end_date
                 )
  )
notfit


#Find gaps between bookings for each room
gaps <- bookings %>% 
  arrange(room_id,start_date) %>% 
  group_by(room_id) %>% 
  mutate(
    next_start = lead(start_date),
    gap_start = end_date,
    end_gap = next_start,
    gap_days = as.numeric(next_start - end_date)
  ) %>% 
  filter(!is.na(next_start), gap_days > 0)
gaps

#Find unused availability periods


unused <- bookings %>% 
  arrange(room_id, start_date) %>% 
  group_by(room_id) %>% 
  mutate(
    next_start = lead(start_date),
      gap_start = end_date,
    gap_end = next_start
  ) %>% 
  filter(!is.na(next_start)) %>% 
  select(room_id, gap_start, gap_end)
unused

#🔵 Nearest Matching
#Match each booking with the closest availability period
library(dplyr)

gaps <- bookings %>%
  arrange(room_id, start_date) %>%
  group_by(room_id) %>%
  mutate(
    gap_start = end_date,
    gap_end = lead(start_date)
  ) %>%
  filter(!is.na(gap_end)) %>%
  select(room_id, gap_start, gap_end)
gaps

closet_gaps <-
  bookings %>% 
  inner_join(gaps,
             by = "room_id"
             ) %>% 
  mutate(
    distance = abs(as.numeric(start_date - gap_end))
  ) %>% 
  group_by(booking_id) %>% 
  slice_min(distance, n = 1) %>%
  ungroup()
closet_gaps

#Find the nearest available room for each booking
nearest <- bookings %>%
  inner_join(rooms, by = "room_id") %>%
  mutate(
    distance = abs(start_date.x - start_date.y)
  ) %>%
  group_by(booking_id) %>%
  slice_min(distance, n = 1)

nearest

