library(dplyr)

set.seed(123)  # for reproducibility

# Create 70 room availability records
rooms <- tibble(
  room_id = sample(100:120, 80, replace = TRUE),
  start_date = as.Date("2024-01-01") + sample(0:60, 80, replace = TRUE),
  end_date   = start_date + sample(2:10, 80, replace = TRUE)
)
rooms
View(rooms)
# Create 80 booking records
bookings <- tibble(
  booking_id = 1:80,
  room_id = sample(100:125, 80, replace = TRUE),  # includes some invalid rooms
  start_date = as.Date("2024-01-01") + sample(0:60, 80, replace = TRUE),
  end_date   = start_date + sample(1:12, 80, replace = TRUE)
)
bookings
View(bookings)

#Room & Booking Join Scenarios
#Basic Overlap
#Find bookings that overlap with room availability

bookings %>% 
  inner_join(rooms, by =join_by(room_id, start_date <= end_date,
             end_date >= start_date))

#Find rooms that have at least one booking overlap
bookings %>% 
  inner_join(rooms, by = join_by(room_id,start_date <= end_date,
                                 end_date >= start_date)) %>% distinct(room_id)

#🔵 No Match Cases
#Find bookings that do not match any room availability
no_match <- bookings %>% 
  anti_join(rooms, by  = join_by(room_id,start_date <= end_date,
                                 end_date >= start_date))
no_match

#Find rooms that were never booked
never_booked <- rooms %>% 
  anti_join(bookings, by= "room_id")
never_booked

#🔵 Full vs Partial Overlap
#Find bookings fully inside a room’s availability period
full <- bookings %>% 
  semi_join(
    rooms,
    by = join_by(
      room_id,
      start_date  >= start_date ,
      end_date  <= end_date  
    )
  )
full
#Find bookings that partially overlap with availability
partial  <- bookings %>% 
  semi_join(
    rooms,
    by = join_by(
      room_id,
      start_date  <= start_date ,
      end_date  >= end_date  
    )
  )
partial

#Find bookings that extend beyond availability dates

extend  <- bookings %>% 
  semi_join(
    rooms,
    by = join_by(
      room_id,
      start_date  < start_date |  end_date  > end_date  
    )
  )
extend

extend_start <- bookings %>%
  semi_join(
    rooms,
    by = join_by(
      room_id,
      start_date < start_date 
    )
  )

extend_end <- bookings %>%
  semi_join(
    rooms,
    by = join_by(
      room_id,
      end_date < end_date  
    )
  )
 extend <- bind_rows(extend_start,extend_end) 
 extend
 
 
