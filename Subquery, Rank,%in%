#For each destination, find the top 3 most delayed flights.
flights %>% 
  group_by(dest) %>% 
  mutate(top_three = dense_rank(desc(arr_delay))) %>% 
  filter(top_three <= 3)
#or
flights %>%
  group_by(dest) %>%
  slice_max(arr_delay, n = 3, with_ties = FALSE)

#In dplyr, the desc() function is used to specify descending order during sorting,
# most commonly inside arrange(). It does not actually reverse values, compute rankings, 
#or transform data in a meaningful analytical way on its own. When used inside mutate(), 
#it can be misleading because it simply modifies the vector (often by negating numeric values) 
#rather than assigning ranks or identifying top values. This is why using desc() alone 
#in mutate() does not give correct results for tasks like finding the top 3 highest values. 
#Instead, desc() should be combined with functions that perform sorting or ranking, 
#such as arrange() for ordering rows or min_rank() for assigning ranks in descending order. 
#A good way to remember this is that desc() only defines direction for sorting, not computation or ranking itself
#internally it behaves like negative numbers not usufule rankings 

