#Q Rank months by their average arrival delay, highest delay first.
flights %>% 
  group_by(month) %>% 
  summarise(avg_delay= mean(arr_delay, na.rm = TRUE)) %>% 
  mutate(rank = dense_rank(desc(avg_delay))) %>% 
  arrange(desc(avg_delay))
